(
    metrics: [
        (
            id: "year",
            name: "年份",
            description: "跨年时增加 1；重开时恢复为 1。",
            initial_value: 1.0,
            min_value: Some(1.0),
        ),
        (
            id: "month",
            name: "月份",
            description: "每次推进增加 1；超过 12 时归 1 并跨年结算。",
            initial_value: 1.0,
            min_value: Some(1.0),
            max_value: Some(12.0),
        ),
        (
            id: "term",
            name: "任期",
            description: "从 1 开始；每次崩溃重开增加 1。",
            initial_value: 1.0,
            min_value: Some(1.0),
        ),
        (
            id: "productivity",
            name: "生产力",
            description: "测试源指标；每变化 1 点，产出立即变化 2 点。",
            initial_value: 10.0,
            min_value: Some(0.0),
            max_value: Some(100.0),
        ),
        (
            id: "output",
            name: "产出",
            description: "立即受生产力影响，上限 120；年末用于计算收入。",
            initial_value: 20.0,
            min_value: Some(0.0),
            max_value: Some(120.0),
            influence: Some(Immediate([
                (source_metric: "productivity", factor: 2.0),
            ])),
        ),
        (
            id: "income",
            name: "年收入",
            description: "年末重算为当前产出 × 1.5；实际变化立即影响储备。",
            initial_value: 0.0,
            min_value: Some(0.0),
            max_value: Some(200.0),
            influence: Some(Annual([
                (source_metric: "output", factor: 1.5),
            ])),
        ),
        (
            id: "reserves",
            name: "储备",
            description: "收入每实际变化 1 点，储备立即变化 0.5 点。",
            initial_value: 50.0,
            min_value: Some(0.0),
            max_value: Some(500.0),
            influence: Some(Immediate([
                (source_metric: "income", factor: 0.5),
            ])),
        ),
        (
            id: "collapse",
            name: "崩溃度",
            description: "达到 100 时重开；普通指标恢复初始值，年份月份归 1，任期加 1。",
            initial_value: 0.0,
            min_value: Some(0.0),
            max_value: Some(100.0),
        ),
    ],
)
